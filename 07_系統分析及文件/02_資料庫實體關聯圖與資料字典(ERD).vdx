                <LineWeight>0.025</LineWeight>
                <Rounding>0.08</Rounding>
            </Line>
            <Text>【LINE_MESSAGES (LINE推播歷程表)】&#xA;* id: VARCHAR(64) [PK]&#xA;# lineUserId: VARCHAR(64) [FK]&#xA;sender: VARCHAR(64)&#xA;targetRole: VARCHAR(32)&#xA;messageType: VARCHAR(32)&#xA;content: TEXT&#xA;timestamp: DATETIME</Text>
