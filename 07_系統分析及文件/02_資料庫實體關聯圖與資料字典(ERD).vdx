                <LocPinX>1.4</LocPinX>
                <LocPinY>1.0</LocPinY>
            </XForm>
            <Fill>
                <FillForegnd>#FEF7E0</FillForegnd>
                <FillBkgnd>#FFFFFF</FillBkgnd>
                <FillPattern>1</FillPattern>
            </Fill>
            <Line>
                <LineColor>#059669</LineColor>
                <LineWeight>0.02</LineWeight>
                <Rounding>0.08</Rounding>
            </Line>
            <Text>【FINANCIAL_LEDGER (利潤分流帳本)】&#xA;* id: VARCHAR(32) [PK]&#xA;# orderId: VARCHAR [FK]&#xA;totalGmv: INT&#xA;techTakeRate: INT (18%)&#xA;coopPassThrough: INT (82%)&#xA;totalAgriSubsidy: INT (8800/人)&#xA;settlementDate: DATETIME</Text>
        </Shape>
        
                    <Shape ID="10" Type="Shape" LineStyle="1" FillStyle="1" TextStyle="1">
