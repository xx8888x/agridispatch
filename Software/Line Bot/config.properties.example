# ========================================================
# 智農派工 (AgriDispatch) - LINE Bot 設定檔範本
# 請複製此檔為 config.properties 並填入您自己的金鑰 (config.properties 已列於 .gitignore，不會被提交)
# ========================================================

# ------------------------------------------------------------------
# 兩個 LINE 官方帳號（規格：07_系統分析及文件/05_LINE官方帳號拆分規格.md 第貳章）
# 兩個 channel 必須建在同一個 Provider 底下。未填或仍為範例值的帳號會以本地模擬模式 (Mock Mode) 運作。
# Channel secret：LINE Developers -> Basic settings；Channel access token：Messaging API -> Channel access token (long-lived)
# Webhook URL：農場主帳號設 https://<公開網域>/callback/farmer，工作者帳號設 https://<公開網域>/callback/worker
# 舊的 line.channel.secret／line.channel.access.token 仍可用，會被視為農場主帳號（過渡期）。
# ------------------------------------------------------------------
line.farmer.channel.secret=請填入農場主帳號的_Channel_Secret
line.farmer.channel.access.token=請填入農場主帳號的_Channel_Access_Token
line.worker.channel.secret=請填入工作者帳號的_Channel_Secret
line.worker.channel.access.token=請填入工作者帳號的_Channel_Access_Token

# 官方帳號 Basic ID（例 @123abcde），用於「請加入另一個帳號」的加好友按鈕；未填則不顯示按鈕
line.farmer.basic.id=
line.worker.basic.id=

# 合作社服務專線：工作者帳號「聯絡合作社」顯示撥號按鈕；未填時只顯示勞動部 1955 專線
coop.contact.phone=

# 帳號綁定頁的 LIFF ID；未填時綁定按鈕連到既有登入頁（LIFF 綁定頁於 P4 製作）
liff.bind.id=

# Line Bot 與後端互相呼叫內部端點的共用金鑰；須與後端 AGRI_LINEBOT_INTERNAL_KEY 相同，
# 且不得與 admin.key、channel secret 相同。未填時不連後端：身分與語言暫存記憶體（重啟後遺失）、查詢改用本地卡片。
# start_all.bat 未設定此環境變數時會自動產生一組給後端與 Line Bot 共用。
internal.key=

# 功能開關：工班合法化（黑轉白），預設 false＝暫時下架（農場主帳號不回黑轉白卡片、服務導覽不列）。
# 改 true 即恢復；圖文選單另需把 tools/make_rich_menus.py 的 FEATURE_LEGALIZE 改 True、重產並上傳。
feature.legalize=false

# 本地伺服器監聽埠號 (預設 5000)
server.port=5000

# 智農派工 Java 後台 API 基礎路徑
backend.api.base=http://localhost:3000/api

# Flex 卡片按鈕連結的前端網站根網址（其下為 AgriDispatch/、linebot/ 子站）
# 實機 LINE 須改為手機連得到的公開 https 網址（例如 Netlify 部署網址），結尾不加斜線
web.base.url=http://localhost:3000/demo

# ------------------------------------------------------------------
# 管理端點金鑰 (保護 /api/config)
# /api/config 可讀取/更新上述 LINE 金鑰設定，屬於高權限管理端點。
# 未設定 admin.key (或環境變數 LINEBOT_ADMIN_KEY) 時，/api/config 會整個停用並回應 403。
# 呼叫時需於 HTTP 標頭帶上： X-Admin-Key: <您設定的值>
# 注意：透過 localtunnel/ngrok 對外穿透時，所有請求在本機端來源位址都會顯示為 127.0.0.1，
# 因此「僅允許本機連線」不是有效的保護機制，務必設定此金鑰。
# 請自行產生一組高強度亂數字串 (例如 32 碼以上)，切勿使用範例值。
# ------------------------------------------------------------------
admin.key=請填入您自訂的管理金鑰

# ------------------------------------------------------------------
# CORS 允許的來源網域 (以逗號分隔)，僅允許白名單內的網頁前端可跨域呼叫本伺服器的 API。
# 預設僅允許本地開發用網址；正式上線請改為您實際的前端網域 (需為 https)。
# ------------------------------------------------------------------
cors.allowed.origins=http://localhost:3000,http://127.0.0.1:3000
