                <FillPattern>1</FillPattern>
            </Fill>
            <Line>
                <LineColor>#06C755</LineColor>
                <LineWeight>0.025</LineWeight>
                <Rounding>0.08</Rounding>
            </Line>
            <Text>【LINE_USERS (LINE使用者綁定表)】&#xA;* id: VARCHAR(32) [PK]&#xA;lineUserId: VARCHAR(64) [UK]&#xA;username: VARCHAR(32)&#xA;displayName: VARCHAR(100)&#xA;role: VARCHAR(32)&#xA;lang: VARCHAR(10) (zh/vi/id)&#xA;isBound: BOOL&#xA;boundAt: DATETIME</Text>
        </Shape>
        
