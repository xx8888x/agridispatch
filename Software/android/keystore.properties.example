# ========================================================
# 智農派工 (AgriDispatch) - Release 簽章設定範本
# 請複製此檔為 keystore.properties (與本檔同目錄，已列於 .gitignore，不會被提交)
# 並填入您實際的 keystore 路徑與密碼。
#
# 若尚未有正式簽章金鑰，可用 Android Studio (Build > Generate Signed Bundle/APK > Create new)
# 或指令 `keytool -genkeypair -v -keystore my-release-key.jks -keyalg RSA -keysize 2048 -validity 10000 -alias my-key-alias`
# 產生一份，並妥善備份保管 (遺失將無法再更新已上架的 App)。
#
# 未提供本檔案時，release 建置不會設定簽章 (signingConfig)，僅產出未簽章 APK。
# ========================================================

# keystore 檔案路徑 (相對於 android/ 目錄，或絕對路徑)
storeFile=../my-release-key.jks

# keystore 密碼
storePassword=請填入您的_Keystore_密碼

# 金鑰別名 (alias)
keyAlias=請填入您的_Key_Alias

# 金鑰密碼 (通常與 storePassword 相同，視建立時設定而定)
keyPassword=請填入您的_Key_密碼
