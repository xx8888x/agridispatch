# ========================================================
# 智農派工 (AgriDispatch) - LINE Bot 環境變數設定檔範本
# 請將此檔複製為 .env 並填入您在 LINE Developers Console 取得的金鑰
#
# ⚠️ 注意：本專案 Java 程式「不會」自動讀取 .env 檔案內容 (無外部相依的 dotenv 套件)。
# 此檔僅作為「應設定哪些環境變數」的文件範本。若要實際生效，請擇一方式：
#   1. 直接改用 config.properties (Config.java 會自動讀取，見 config.properties.example)
#   2. 或自行將以下變數設為系統/終端機環境變數後再執行 run.bat，例如 (cmd)：
#        set LINE_CHANNEL_SECRET=your_channel_secret_here
#        set LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
#        run.bat
# 環境變數的優先權高於 config.properties。
# ========================================================

# LINE Developers -> Messaging API -> Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# LINE Developers -> Basic settings -> Channel secret
LINE_CHANNEL_SECRET=your_channel_secret_here

# 本地伺服器監聽埠號 (預設 5000)
PORT=5000

# 智農派工 Java 後台 API 網址 (預設 http://localhost:3000)
BACKEND_API_BASE=http://localhost:3000/api

# /api/config 管理端點存取金鑰；未設定則該 API 整個停用 (回應 403)，詳見 README。
LINEBOT_ADMIN_KEY=your_own_high_entropy_admin_key_here

# CORS 允許的來源網域 (以逗號分隔)，預設僅允許本地開發網址
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
