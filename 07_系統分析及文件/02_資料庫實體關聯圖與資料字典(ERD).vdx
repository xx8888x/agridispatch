                <FillBkgnd>#FFFFFF</FillBkgnd>
                <FillPattern>1</FillPattern>
            </Fill>
            <Line>
                <LineColor>#059669</LineColor>
                <LineWeight>0.02</LineWeight>
                <Rounding>0.08</Rounding>
            </Line>
            <Text>【CLOCK_INS (GPS現場打卡)】&#xA;* id: VARCHAR(64) [PK]&#xA;# workerId: VARCHAR [FK]&#xA;latitude: FLOAT&#xA;longitude: FLOAT&#xA;locationName: VARCHAR&#xA;clockInTime: DATETIME&#xA;status: VARCHAR(20)</Text>
        </Shape>
        
        <Shape ID="7" Type="Shape" LineStyle="1" FillStyle="1" TextStyle="1">
            <XForm>
                <PinX>10.5</PinX>
                <PinY>6.0</PinY>
                <Width>2.6</Width>
                <Height>2.0</Height>
                <LocPinX>1.3</LocPinX>
                <LocPinY>1.0</LocPinY>
            </XForm>
            <Fill>
                <FillForegnd>#E6F4EA</FillForegnd>
                <FillBkgnd>#FFFFFF</FillBkgnd>
                <FillPattern>1</FillPattern>
            </Fill>
            <Line>
                <LineColor>#059669</LineColor>
                <LineWeight>0.02</LineWeight>
                <Rounding>0.08</Rounding>
            </Line>
            <Text>【TALENTS (自願登錄人才庫)】&#xA;* id: VARCHAR(32) [PK]&#xA;name: VARCHAR(100)&#xA;category: VARCHAR(50)&#xA;phone: VARCHAR(30)&#xA;experience: TEXT&#xA;pdpaConsent: BOOL (個資19條)&#xA;registeredAt: DATETIME</Text>
        </Shape>
        
        <Shape ID="8" Type="Shape" LineStyle="1" FillStyle="1" TextStyle="1">
            <XForm>
                <PinX>10.5</PinX>
                <PinY>9.0</PinY>
                <Width>2.8</Width>
                <Height>1.8</Height>
                <LocPinX>1.4</LocPinX>
                <LocPinY>0.9</LocPinY>
            </XForm>
            <Fill>
                <FillForegnd>#E8F0FE</FillForegnd>
                <FillBkgnd>#FFFFFF</FillBkgnd>
                <FillPattern>1</FillPattern>
            </Fill>
            <Line>
                <LineColor>#059669</LineColor>
                <LineWeight>0.02</LineWeight>
                <Rounding>0.08</Rounding>
            </Line>
            <Text>【WEATHER_STATES (天候避險狀態)】&#xA;* id: VARCHAR(32) [PK]&#xA;isRainMode: BOOL&#xA;currentWeather: VARCHAR&#xA;alertLevel: VARCHAR&#xA;securedRevenue: INT (62500)&#xA;dailyCapacityHours: INT</Text>
        </Shape>
        
        <Shape ID="9" Type="Shape" LineStyle="1" FillStyle="1" TextStyle="1">
            <XForm>
                <PinX>1.5</PinX>
                <PinY>2.5</PinY>
