{
  "type": "bubble",
  "size": "mega",
  "header": {
    "type": "box",
    "layout": "vertical",
    "backgroundColor": "#1E3A8A",
    "paddingAll": "20px",
    "contents": [
      {
        "type": "text",
        "text": "天候警報通知",
        "color": "#93C5FD",
        "size": "xs",
        "weight": "bold"
      },
      {
        "type": "text",
        "text": "突發暴雨警報・田區暫停採收",
        "color": "#FFFFFF",
        "size": "lg",
        "weight": "bold"
      }
    ]
  },
  "body": {
    "type": "box",
    "layout": "vertical",
    "spacing": "md",
    "paddingAll": "20px",
    "contents": [
      {
        "type": "box",
        "layout": "baseline",
        "spacing": "sm",
        "contents": [
          { "type": "text", "text": "目前天候", "color": "#64748B", "size": "xs", "flex": 2 },
          { "type": "text", "text": "暴雨警戒 23°C (滯留鋒面進逼)", "color": "#EF4444", "size": "xs", "weight": "bold", "flex": 5 }
        ]
      },
      {
        "type": "box",
        "layout": "baseline",
        "spacing": "sm",
        "contents": [
          { "type": "text", "text": "作業安排", "color": "#64748B", "size": "xs", "flex": 2 },
          { "type": "text", "text": "暫停田間採收，依現場小工頭通知復工或改期", "color": "#0F172A", "size": "xs", "weight": "bold", "flex": 5 }
        ]
      },
      {
        "type": "box",
        "layout": "baseline",
        "spacing": "sm",
        "contents": [
          { "type": "text", "text": "接駁專車", "color": "#64748B", "size": "xs", "flex": 2 },
          { "type": "text", "text": "專車待命，視天候接回工班", "color": "#0F172A", "size": "xs", "weight": "bold", "flex": 5 }
        ]
      }
    ]
  },
  "footer": {
    "type": "box",
    "layout": "vertical",
    "spacing": "sm",
    "paddingAll": "16px",
    "contents": [
      {
        "type": "button",
        "style": "primary",
        "color": "#1E3A8A",
        "height": "sm",
        "action": {
          "type": "uri",
          "label": "查看最新派工狀態",
          "uri": "https://agridispatch.tw/web/app.html#admin_tech"
        }
      }
    ]
